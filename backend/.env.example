# ============================================================================
# API — La Forteresse de l'Eternel
# Copiez ce fichier vers backend/.env et adaptez les valeurs.
# Ne commitez JAMAIS backend/.env.
# ============================================================================

NODE_ENV=development
PORT=3000
# En developpement, l'interface (Vite) occupe le port 3000 : mettez PORT=4000
# ici pour que l'API reste joignable via le proxy. En production, l'API sert
# aussi l'interface compilee : conservez 3000.
API_PREFIX=/api/v1

# --- URLs ---------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
# URL publique de l'API pour les liens signes de fichiers.
# Laisser vide = liens relatifs (/api/v1/files/...), recommande derriere un proxy.
PUBLIC_API_URL=
# Origines supplementaires autorisees (CORS), separees par des virgules
CORS_ORIGINS=

# --- Base de donnees ----------------------------------------------------
# Developpement sans PostgreSQL : laisser vide (PGlite, donnees locales).
# Production / Supabase : chaine de connexion PostgreSQL (pooler, port 6543).
# DATABASE_URL=postgresql://postgres:<mot-de-passe>@db.<project>.supabase.co:5432/postgres
DATABASE_URL=
PGLITE_DATA_DIR=./var/pglite
AUTO_MIGRATE=true

# --- Stockage de fichiers ----------------------------------------------
# local (disque, URLs signees par l'API) ou supabase (bucket prive)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads
SUPABASE_URL=
# ATTENTION : renseigner SUPABASE_ANON_KEY bascule TOUTE l'authentification
# sur Supabase Auth (voir supabaseAuthEnabled() dans middlewares/auth.ts).
# L'application gere ses propres comptes (scrypt + cookie signe) : LAISSER VIDE
# pour conserver ce fonctionnement. A ne renseigner que si vous migrez
# volontairement vers Supabase Auth.
SUPABASE_ANON_KEY=
# Cle serveur : requise pour Storage depuis le backend. Ne jamais l'exposer
# cote frontend (aucune variable VITE_* ne doit la contenir).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=media
SUPABASE_PUBLIC_BUCKET=public-assets

# --- Session ------------------------------------------------------------
# Generer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change_me_to_a_random_48_byte_string_minimum_32_chars
SESSION_TTL_HOURS=168
COOKIE_NAME=lfe_session
# true derriere HTTPS
COOKIE_SECURE=false

# --- Premier administrateur --------------------------------------------
# Utilise uniquement par `npm run create-admin` (jamais de mot de passe en dur).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FIRST_NAME=
ADMIN_BOOTSTRAP_LAST_NAME=

# --- Donnees de demonstration -----------------------------------------
SEED_DEMO_DATA=false
MAX_UPLOAD_MB=25
LOG_LEVEL=info
